#!/usr/bin/env bash
# Synthetic input-method test; never uses an account or the desktop clipboard.
set -euo pipefail
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
scratch=$(mktemp -d /tmp/french-input.XXXXXX)
trap 'rm -rf -- "$scratch"' EXIT
mkdir -p "$scratch/NativeInput"
cp "$repo/tests/native-input.cpp" "$scratch/NativeInput/"
/usr/lib/qt6/moc $(pkg-config --cflags Qt6Qml Qt6Gui) "$scratch/NativeInput/native-input.cpp" -o "$scratch/NativeInput/native-input.moc"
g++ -shared -fPIC "$scratch/NativeInput/native-input.cpp" -o "$scratch/NativeInput/libnativeinput.so" $(pkg-config --cflags --libs Qt6Qml Qt6Gui)
printf 'module NativeInput\nplugin nativeinput\n' > "$scratch/NativeInput/qmldir"
ln -s /usr/share/omarchy/shell/Commons "$scratch/Commons"
ln -s /usr/share/omarchy/shell/Ui "$scratch/Ui"
ln -s "$repo" "$scratch/plugin"
python3 - "$repo/tests/composer.qml" "$scratch/shell.qml" <<'PYTEST'
from pathlib import Path
import sys
s=Path(sys.argv[1]).read_text().replace('import QtQuick\n','import QtQuick\nimport NativeInput 1.0\n',1)
s=s.replace('ShellRoot {','ShellRoot {\n    Probe { id: probe }',1)
s=s.replace('        function test_dates_priority','''        function test_french_composition() {
            var field = findChild(composer, "taskName");
            field.text = "";
            verify(probe.compose(field, "^", "ê"));
            verify(probe.compose(field, "'", "é"));
            compare(field.text, "êé");
            field.selectAll();
            verify(probe.compose(field, "`", "à"));
            compare(field.text, "à");
        }
        function test_dates_priority''')
Path(sys.argv[2]).write_text(s)
PYTEST
TODOIST_TEST_DIR="$scratch" QML_IMPORT_PATH="$scratch" QT_QPA_PLATFORM=offscreen timeout 40 quickshell -p "$scratch" --no-color > "$scratch/log" 2>&1
cat "$scratch/log"
rg -q 'COMPOSER UI RESULTS [0-9]+ passed 0 failed' "$scratch/log"
